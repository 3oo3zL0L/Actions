<!DOCTYPE html>
<html lang="nl">
  <head>
    <title><%= content_for(:title) || "Actielijst" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="application-name" content="Actielijst">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#f6f5f2" media="(prefers-color-scheme: light)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="wrap">
      <%= yield %>
    </div>

    <div class="toasts" aria-live="polite">
      <%= tag.p notice, class: "toast", role: "status", data: { controller: "toast" } if notice %>
      <%= tag.p alert, class: "toast toast--alert", role: "alert", data: { controller: "toast" } if alert %>
    </div>
  </body>
</html>
