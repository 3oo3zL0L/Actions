<!DOCTYPE html>
<html lang="nl">
  <head>
    <title><%= content_for(:title) || "Werkplek" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="application-name" content="Werkplek">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#101113">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="<%= class_names "wrap", "wrap--wide": content_for?(:wide) %>">
      <% if authenticated? %>
        <nav class="nav" aria-label="Hoofdmenu">
          <%= link_to "Werkplek", root_path, class: class_names("nav__link", "nav__link--current": current_page?(root_path) || current_page?(desk_path)) %>
          <%= link_to "Acties", items_path, class: class_names("nav__link", "nav__link--current": controller_name == "items") %>
          <%= link_to "Programma's", programs_path, class: class_names("nav__link", "nav__link--current": controller_name == "programs") %>
          <%= link_to "Koppelingen", sources_path, class: class_names("nav__link", "nav__link--current": controller_name == "sources") %>
        </nav>
      <% end %>
      <%= tag.p notice, class: "flash", role: "status" if notice %>
      <%= tag.p alert, class: "flash flash--alert", role: "alert" if alert %>
      <%= yield %>
    </div>
  </body>
</html>
