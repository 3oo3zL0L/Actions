<% content_for :title, "Importeren" %>

<header class="masthead"><h1>Importeren</h1></header>

<p class="section-note">
  Plak de inhoud van <code>/areas/todos.md</code>. Kopjes worden programma's, regels als
  <code>- [ ] actie | wie | deadline</code> worden acties.
</p>

<%= form_with url: import_path, class: "import" do |form| %>
  <%= form.label :markdown, "Markdown", class: "visually-hidden" %>
  <%= form.text_area :markdown, rows: 14, required: true, placeholder: "## Contracten\n- [ ] JProfiler-licentie verlengen | Kim | 1 okt" %>
  <div class="actions">
    <%= form.button "Zet over", class: "btn btn--primary" %>
    <%= link_to "Terug", items_path, class: "btn btn--quiet" %>
  </div>
<% end %>
