<%= tag.li class: [ "item", { "item--completed": item.completed?, "item--dropped": item.dropped? } ] do %>
  <%= turbo_frame_tag item do %>
    <div class="row">
      <%= button_to item_completion_path(item), method: item.closed? ? :delete : :post,
            class: [ "tick", { "tick--checked": item.completed? } ], form_class: "tick-form",
            form: { data: { turbo_frame: "_top" } },
            aria: { label: "#{item.closed? ? "Terugzetten" : "Afgerond"}: #{item.text}" } do %>
        <span class="tick__mark" aria-hidden="true"></span>
      <% end %>

      <%= link_to edit_item_path(item), class: "row__body", aria: { label: "Bewerk: #{item.text}" } do %>
        <span class="text"><%= item.text %></span>
        <%= tag.span item.why, class: "why" if item.why? && item.prioritized? && item.active? %>
        <%= tag.span item.note, class: "note" if item.note? %>
        <span class="meta">
          <%= tag.span "indelen…", class: "chip chip--busy" unless item.classified? %>
          <%= tag.span "herschrijven…", class: "chip chip--busy" if item.rewriting? %>
          <%= tag.span "n.v.t.", class: "chip" if item.dropped? %>
          <% if item.due_on %>
            <%= tag.span class: [ "chip", { "chip--late": item.late? } ] do %>
              <%= "verlopen " if item.late? %><%= l item.due_on, format: :short %>
            <% end %>
          <% end %>
          <span class="who"><%= item.who %></span>
          <span><%= item.program.name %></span>
        </span>
      <% end %>

      <% if item.active? %>
        <div class="row__actions">
          <%= link_to item.mail_url, class: "mail", target: "_blank", rel: "noopener", title: "Open mail", aria: { label: "Open mail" } do %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <% end if item.mail_url %>

          <% if item.prioritized? %>
            <%= button_to "Deprioritiseer", item_priority_path(item), method: :delete, class: "pill pill--down", form: { data: { turbo_frame: "_top" } } %>
          <% else %>
            <%= button_to "Prioritiseer", item_priority_path(item), class: "pill pill--up", form: { data: { turbo_frame: "_top" } } %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
