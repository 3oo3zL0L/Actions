<% show_program = local_assigns.fetch(:show_program, true) %>
<%= tag.li class: [ "item", { "item--completed": item.completed?, "item--dropped": item.dropped?, "item--late": item.late? } ] do %>
  <%= turbo_frame_tag item do %>
    <div class="row">
      <%= button_to item_completion_path(item), method: item.closed? ? :delete : :post,
            class: [ "tick", { "tick--checked": item.completed? } ], form_class: "tick-form",
            form: { data: { turbo_frame: "_top" } },
            aria: { label: "#{item.closed? ? "Terugzetten" : "Afgerond"}: #{item.text}" } do %>
        <span class="tick__mark" aria-hidden="true"></span>
      <% end %>

      <%= link_to edit_item_path(item), class: "row__body", aria: { label: "Bewerk: #{item.text}" } do %>
        <span class="text"><%= item.text %></span>
        <%= tag.span item.why, class: "why" if item.why? && item.prioritized? && item.active? %>
        <%= tag.span item.note, class: "note" if item.note? %>
        <span class="meta">
          <%= tag.span "indelen…", class: "chip chip--busy" unless item.classified? %>
          <%= tag.span "herschrijven…", class: "chip chip--busy" if item.rewriting? %>
          <%= tag.span "n.v.t.", class: "chip" if item.dropped? %>
          <%= tag.span due_label(item), class: [ "chip chip--due", { "chip--late": item.late?, "chip--soon": due_soon?(item) } ] if item.due_on %>
          <% unless item.own? %>
            <span class="who"><%= tag.span initials(item.who), class: "who__avatar", aria: { hidden: true } %><%= item.who %></span>
          <% end %>
          <%= tag.span item.program.name, class: "program-name" if show_program %>
        </span>
      <% end %>

      <% if item.active? %>
        <div class="row__actions">
          <%= ask_claude_button item %>

          <% if item.prioritized? %>
            <%= button_to item_priority_path(item), method: :delete, class: "act act--later", title: "Haal van vandaag",
                  aria: { label: "Haal van vandaag: #{item.text}" }, form: { data: { turbo_frame: "_top" } } do %>
              <%= icon :down %><span class="act__label">Later</span>
            <% end %>
          <% else %>
            <%= button_to item_priority_path(item), class: "act act--today", title: "Zet op vandaag",
                  aria: { label: "Zet op vandaag: #{item.text}" }, form: { data: { turbo_frame: "_top" } } do %>
              <%= icon :up %><span class="act__label">Vandaag</span>
            <% end %>
          <% end %>

          <%= link_to item.mail_url, class: "act act--icon", target: "_blank", rel: "noopener", title: "Open mail", aria: { label: "Open mail" } do %>
            <%= icon :mail %>
          <% end if item.mail_url %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
