<%= form_with model: Capture.new, class: "composer", data: { controller: "composer dictation", action: "turbo:submit-end->composer#reset turbo:submit-end->dictation#reset keydown@window->composer#shortcut" } do |form| %>
  <div class="composer__field">
    <%= form.label :body, "Nieuwe actie", class: "visually-hidden" %>
    <%= form.text_area :body, rows: 1, required: true, placeholder: "Nieuwe actie…",
          aria: { describedby: "composer_hint" },
          data: { composer_target: "input", dictation_target: "input", action: "keydown->composer#submitOnEnter input->composer#grow" } %>
    <button type="button" class="mic" aria-pressed="false" aria-label="Inspreken" title="Inspreken"
            data-dictation-target="button" data-action="dictation#toggle">
      <%= icon :mic %>
    </button>
  </div>
  <%= form.button "Op de lijst", class: "btn btn--primary composer__submit" %>
  <p class="tip" data-dictation-target="tip" hidden></p>
  <p class="hint" id="composer_hint">
    <%= Assistant.enabled? ? "Eén actie per regel. Claude kiest het programma." : "Eén actie per regel. Nieuwe acties komen onder Overig." %>
    <span class="hint__keys"><kbd>N</kbd> om te typen · <kbd>Enter</kbd> zet op de lijst · <kbd>Shift</kbd>+<kbd>Enter</kbd> nieuwe regel</span>
  </p>
<% end %>
